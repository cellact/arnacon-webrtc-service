{
  "name": "arnacon-webrtc-service",
  "version": "0.2.37",
  "description": "Arnacon WebRTC core runtime and service modules",
  "main": "./webRTCservice/core.js",
  "type": "commonjs",
  "exports": {
    ".": "./webRTCservice/core.js",
    "./core": "./webRTCservice/core.js",
    "./service/esimera": "./webRTCservice/services/esimera.js",
    "./service/esimera/runner": "./webRTCservice/services/esimera.runner.js",
    "./service/esimera/config": "./services/esimera.json",
    "./service/basicService": "./webRTCservice/services/basicService.js",
    "./service/basicService/runner": "./webRTCservice/services/basicService.runner.js",
    "./service/basicService/config": "./services/basicService.json"
  },
  "files": [
    "webRTCservice/**/*",
    "services/**/*",
    "globalserviceconfig.json",
    "demoAudio/**/*",
    "!webRTCservice/**/.env*",
    "!webRTCservice/**/*.token",
    "!webRTCservice/**/secrets/**",
    "!services/**/.env*",
    "!services/**/*.token",
    "!services/**/secrets/**"
  ],
  "scripts": {
    "test": "npm run test:routing && npm run test:poly",
    "test:routing": "node --test webRTCservice/modules/routing/__tests__/*.test.js webRTCservice/services/__tests__/*.test.js webRTCservice/modules/calls/inbound/__tests__/*.test.js webRTCservice/modules/calls/webrtc/__tests__/*.test.js",
    "test:poly": "node --test webRTCservice/modules/calls/poly/__tests__/*.test.js",
    "test:werift": "node --test --test-concurrency=1 webRTCservice/modules/calls/poly/__tests__/WebRtcNegotiation.werift.integration.test.js",
    "test:poly:all": "npm run test:poly && npm run test:werift",
    "test:scenarios": "node --test webRTCservice/modules/calls/poly/__tests__/Scenarios.test.js",
    "build": "node webRTCservice/build.js",
    "clean": "node webRTCservice/clean.js",
    "validate:exports": "node webRTCservice/validateExports.js",
    "pack:dry": "npm pack --dry-run",
    "start:service:esimera": "SERVICE_ID=esimera node webRTCservice/webRTCmanager.js",
    "start:service:basic": "SERVICE_ID=basicService node webRTCservice/webRTCmanager.js",
    "prepublishOnly": "npm run build && npm run validate:exports",
    "publish:patch": "npm version patch && npm publish",
    "publish:minor": "npm version minor && npm publish",
    "publish:major": "npm version major && npm publish"
  },
  "dependencies": {
    "arnacon-sdk": "1.0.41",
    "ethers": "^5.7.2",
    "sip.js": "^0.21.2",
    "werift": "*",
    "ws": "^8.16.0"
  },
  "engines": {
    "node": ">=18"
  }
}
